# Copy this file to .env on the VPS and replace every placeholder.

DOMAIN=mowan.example.com
ADMIN_USERS=admin:replace-with-a-strong-password,friend:replace-with-another-strong-password
COOKIE_SECRET=replace-with-a-long-random-secret
SESSION_RETENTION_DAYS=7

# Optional: enable default LLM replies through OpenRouter.
LLM_ENABLED=false
LLM_MODEL=deepseek/deepseek-v3.2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=900
LLM_TIMEOUT_MS=45000
LLM_RETRY_COUNT=2
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# OPENROUTER_HTTP_REFERER=https://mowan.example.com
# OPENROUTER_APP_TITLE=Mowan

# Optional: Qwen/DashScope TTS voice cloning.
# DASHSCOPE_API_KEY=sk-your-dashscope-key
QWEN_TTS_ENABLED=true
QWEN_TTS_REGION=beijing
QWEN_TTS_MODE=non_realtime
QWEN_TTS_CLONE_MODEL=qwen3-tts-vc-2026-01-22
QWEN_TTS_MODEL=qwen3-tts-vc-2026-01-22
QWEN_TTS_PREFERRED_NAME=mowan
# QWEN_TTS_VOICE=voice-id-returned-by-clone-script
# Realtime VC needs a separate voice cloned with qwen3-tts-vc-realtime-2026-01-15.
QWEN_TTS_REALTIME_MODEL=qwen3-tts-vc-realtime-2026-01-15
# QWEN_TTS_REALTIME_VOICE=realtime-voice-id-returned-by-clone-script
QWEN_TTS_SAMPLE_RATE=24000
QWEN_TTS_TIMEOUT_MS=45000
# Qwen-TTS-Realtime docs currently mark these controls unsupported for this series.
# QWEN_TTS_REALTIME_CONTROLS=false
# QWEN_TTS_SPEECH_RATE=1
# QWEN_TTS_PITCH_RATE=1
# QWEN_TTS_VOLUME=50
# Keep generated audio in the Docker data volume.
AUDIO_DIR=/data/audio
