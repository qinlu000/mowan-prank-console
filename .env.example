HOST=127.0.0.1
PORT=5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# Optional: bootstrap or update multiple admin accounts on startup.
# ADMIN_USERS=admin:change-this-admin-password,friend:change-this-friend-password

# Deployment settings.
DOMAIN=mowan.example.com
COOKIE_SECRET=change-this-cookie-secret
DATABASE_URL=file:data/mowan.sqlite
SESSION_RETENTION_DAYS=7

# Optional: enable default LLM replies through OpenRouter.
# When OPENROUTER_API_KEY is set and LLM_ENABLED is not "false", visitor messages are answered by the model.
# Backend admins can still interrupt by sending a manual reply, stopping generation, or revealing the prank.
LLM_ENABLED=false
LLM_MODEL=deepseek/deepseek-v3.2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=900
LLM_TIMEOUT_MS=45000
LLM_RETRY_COUNT=2
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# OPENROUTER_HTTP_REFERER=http://127.0.0.1:5173
# OPENROUTER_APP_TITLE=Mowan

# Optional: Qwen/DashScope TTS voice cloning.
# Keep local voice samples out of Git. Use WAV 16-bit, MP3, or M4A; 10-20s recommended; <10MB.
# DASHSCOPE_API_KEY=sk-your-dashscope-key
QWEN_TTS_ENABLED=true
QWEN_TTS_REGION=beijing
QWEN_TTS_CLONE_MODEL=qwen3-tts-vc-2026-01-22
QWEN_TTS_MODEL=qwen3-tts-vc-2026-01-22
QWEN_TTS_PREFERRED_NAME=mowan
# QWEN_TTS_VOICE=voice-id-returned-by-clone-script
# AUDIO_DIR=data/audio
